<?xml version="1.0" encoding="utf-8"?>
<!-- النسخ الاحتياطي والنقل إلى جهاز جديد (Android 12+): نفس قواعد backup_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="premium.xml" />
        <exclude domain="file" path="crash.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud.xml" />
        <exclude domain="sharedpref" path="premium.xml" />
        <exclude domain="file" path="crash.txt" />
    </device-transfer>
</data-extraction-rules>
